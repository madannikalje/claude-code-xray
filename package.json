{
  "name": "claude-code-xray",
  "version": "0.1.0",
  "description": "Local visualizer that shows what Claude Code is doing inside a session: the agentic loop, API calls, tools, subagents, context window, cache and hooks.",
  "type": "module",
  "private": true,
  "bin": {
    "claude-code-xray": "./server.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/",
    "hooks:install": "node server.mjs --install-hooks",
    "hooks:uninstall": "node server.mjs --uninstall-hooks"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/<your-user>/claude-code-xray"
  },
  "keywords": [
    "claude-code",
    "observability",
    "visualizer",
    "agent",
    "hooks",
    "jsonl"
  ]
}
